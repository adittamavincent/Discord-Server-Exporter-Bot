# Discord Bot Token (required)
DISCORD_TOKEN=your_bot_token_here

# Guild/Server ID to export (optional - uses first available guild if not set)
GUILD_ID=

# Output directory (default: ./output)
OUTPUT_DIR=output

# Maximum members to export (default: 1000)
# Increase for larger servers, decrease for faster exports
MAX_MEMBERS=1000

# Delay between API requests in seconds (default: 0.5)
# Increase if hitting rate limits
REQUEST_DELAY=0.5

# Export options (true/false)
EXPORT_MARKDOWN=true
EXPORT_AI_SUMMARY=true
EXPORT_ZIP=true
EXPORT_AI_PROMPT=true

# Logging
LOG_LEVEL=INFO
# LOG_FILE=export.log
